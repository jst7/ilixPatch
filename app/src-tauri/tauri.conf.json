{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ilixPatch",
  "version": "0.3.1",
  "identifier": "dev.ilixpatch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ilixPatch",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jorge Segovia Tormo",
    "copyright": "© 2026 Jorge Segovia Tormo and ilixPatch contributors",
    "homepage": "https://github.com/jst7",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
